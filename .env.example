# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
#
# NONE of these are required for the offline demo (`python -m src.demo`).
# They only matter if you wire this system to a real BigQuery project and a
# live options feed, per docs/architecture.md.

# Google Cloud project that would own the BigQuery dataset in a deployed build.
PROJECT_ID=your-gcp-project-id

# BigQuery dataset for market/source tables.
DATASET=your_dataset_name

# BigQuery dataset for operational audit/history tables (see sql/).
# Defaults to DATASET when unset.
# AUDIT_DATASET=your_audit_dataset

# Where the decision-layer JSON state file is written.
# Defaults to ./data/state/decision_state.json inside the repo.
# DECISION_STATE_DIR=/path/to/state/dir

# Synthetic portfolio notional used by the demo and the decision engine (USD).
HEDGE_NOTIONAL_USD=100000
# Hedge budget as a fraction of notional (0.015 = 1.5%).
HEDGE_BUDGET_PCT=0.015

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
